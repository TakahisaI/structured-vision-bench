{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic invoice extraction",
  "type": "object",
  "required": [
    "documentKind",
    "invoiceNumber",
    "issuedAt",
    "currency",
    "lines",
    "totalAmount"
  ],
  "properties": {
    "documentKind": {
      "type": "string",
      "const": "synthetic_invoice"
    },
    "invoiceNumber": {
      "type": "string"
    },
    "issuedAt": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "const": "JPY"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lineNo",
          "description",
          "quantity",
          "unitPrice",
          "amount"
        ],
        "properties": {
          "lineNo": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unitPrice": {
            "type": "integer"
          },
          "amount": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "totalAmount": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
