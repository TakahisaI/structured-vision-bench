{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TakahisaI/structured-vision-bench/schemas/suite-v1.schema.json",
  "title": "Structured Vision Bench suite v1",
  "description": "Immutable execution plan for an ordered set of benchmark bundles.",
  "type": "object",
  "required": [
    "suiteVersion",
    "suiteId",
    "provider",
    "phase",
    "repeat",
    "requirementVerifier",
    "cases"
  ],
  "properties": {
    "suiteVersion": {
      "type": "integer",
      "const": 1
    },
    "suiteId": {
      "$ref": "#/$defs/safeLabel"
    },
    "provider": {
      "type": "object",
      "required": [
        "id",
        "route",
        "implementationVersion",
        "protocolVersion",
        "requested"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeLabel"
        },
        "route": {
          "$ref": "#/$defs/safeLabel"
        },
        "implementationVersion": {
          "$ref": "#/$defs/nullableSafeLabel"
        },
        "protocolVersion": {
          "$ref": "#/$defs/nullableSafeLabel"
        },
        "requested": {
          "type": "object",
          "required": [
            "model",
            "effort",
            "maxTokens"
          ],
          "properties": {
            "model": {
              "$ref": "#/$defs/nullableSafeLabel"
            },
            "effort": {
              "$ref": "#/$defs/nullableSafeLabel"
            },
            "maxTokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "phase": {
      "$ref": "#/$defs/safeLabel"
    },
    "repeat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "requirementVerifier": {
      "type": "object",
      "required": [
        "id",
        "version",
        "consumerSourceCommit"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeLabel"
        },
        "version": {
          "$ref": "#/$defs/safeLabel"
        },
        "consumerSourceCommit": {
          "$ref": "#/$defs/nullableSafeLabel"
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "sanitizer": {
      "$ref": "#/$defs/sanitizer"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safeLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "nullableSafeLabel": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "command": {
      "type": "object",
      "required": [
        "executable",
        "argv",
        "envAllowlist",
        "timeoutMs",
        "outputLimitBytes"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "argv": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "envAllowlist": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "outputLimitBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": [
        "required",
        "command",
        "expectedGateId",
        "expectedProtocolVersion",
        "snapshotDigest",
        "runtimeBindingIdentity",
        "runtimeBindingDigest",
        "approvedScopeIdentity",
        "approvedScopeDigest",
        "phase"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "expectedGateId": {
          "$ref": "#/$defs/safeLabel"
        },
        "expectedProtocolVersion": {
          "type": "integer",
          "const": 1
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "runtimeBindingIdentity": {
          "$ref": "#/$defs/safeLabel"
        },
        "runtimeBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "approvedScopeIdentity": {
          "$ref": "#/$defs/safeLabel"
        },
        "approvedScopeDigest": {
          "$ref": "#/$defs/digest"
        },
        "phase": {
          "$ref": "#/$defs/safeLabel"
        }
      },
      "additionalProperties": false
    },
    "sanitizer": {
      "type": "object",
      "required": [
        "command",
        "expectedSanitizerId",
        "expectedProtocolVersion",
        "allowedFindingPathPatterns",
        "failureCodes"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/command"
        },
        "expectedSanitizerId": {
          "$ref": "#/$defs/safeLabel"
        },
        "expectedProtocolVersion": {
          "type": "integer",
          "const": 1
        },
        "allowedFindingPathPatterns": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1024
          },
          "uniqueItems": true
        },
        "failureCodes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/safeLabel"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "path",
        "expectedPolicyVersion",
        "expectedPolicyDigest",
        "expectedPolicyTargetIdentityDigest",
        "expectedPolicyBindingDigest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "expectedPolicyVersion": {
          "type": "integer",
          "minimum": 1
        },
        "expectedPolicyDigest": {
          "$ref": "#/$defs/digest"
        },
        "expectedPolicyTargetIdentityDigest": {
          "$ref": "#/$defs/digest"
        },
        "expectedPolicyBindingDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "bundlePath",
        "expectedBundleManifestDigest",
        "expectedCaseInputIdentityVersion",
        "expectedCaseInputIdentityDigest",
        "sanitizerRequirementVersion",
        "sanitizerRequired",
        "policyRequired",
        "sanitizerRequirementReason",
        "requirementDecisionDigest"
      ],
      "properties": {
        "bundlePath": {
          "$ref": "#/$defs/relativePath"
        },
        "expectedBundleManifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "expectedCaseInputIdentityVersion": {
          "type": "integer",
          "const": 1
        },
        "expectedCaseInputIdentityDigest": {
          "$ref": "#/$defs/digest"
        },
        "sanitizerRequirementVersion": {
          "type": "integer",
          "const": 1
        },
        "sanitizerRequired": {
          "type": "boolean"
        },
        "policyRequired": {
          "type": "boolean"
        },
        "sanitizerRequirementReason": {
          "$ref": "#/$defs/safeLabel"
        },
        "requirementDecisionDigest": {
          "$ref": "#/$defs/digest"
        },
        "policy": {
          "$ref": "#/$defs/policy"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "policy"
          ],
          "properties": {
            "sanitizerRequired": {
              "const": true
            },
            "policyRequired": {
              "const": true
            }
          }
        },
        {
          "not": {
            "required": [
              "policy"
            ]
          },
          "properties": {
            "sanitizerRequired": {
              "const": false
            },
            "policyRequired": {
              "const": false
            }
          }
        }
      ]
    }
  }
}
