{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TakahisaI/structured-vision-bench/schemas/suite-slot-event-v1.schema.json",
  "title": "Structured Vision Bench suite slot event v1",
  "type": "object",
  "required": [
    "suiteSlotEventVersion",
    "suiteSlotEventIdentityVersion",
    "suiteRunId",
    "sequence",
    "previousEventId",
    "eventId",
    "recordedAt",
    "caseIndex",
    "repeatIndex",
    "attemptKey",
    "runId",
    "attemptId",
    "previousStatus",
    "status",
    "failureCode",
    "outcomeIdentityDigest"
  ],
  "properties": {
    "suiteSlotEventVersion": {
      "type": "integer",
      "const": 1
    },
    "suiteSlotEventIdentityVersion": {
      "type": "integer",
      "const": 1
    },
    "suiteRunId": {
      "$ref": "#/$defs/digest"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999
    },
    "previousEventId": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "eventId": {
      "$ref": "#/$defs/digest"
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "caseIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "repeatIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "attemptKey": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^c[0-9a-z]+-r[0-9a-z]+$"
    },
    "runId": {
      "$ref": "#/$defs/digest"
    },
    "attemptId": {
      "$ref": "#/$defs/digest"
    },
    "previousStatus": {
      "$ref": "#/$defs/status"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "failureCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/failureCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcomeIdentityDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "sequence": {
              "const": 0
            },
            "previousEventId": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            },
            "previousEventId": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "running"
            },
            "failureCode": {
              "type": "null"
            },
            "outcomeIdentityDigest": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "succeeded"
            },
            "failureCode": {
              "type": "null"
            },
            "outcomeIdentityDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "failed"
            },
            "failureCode": {
              "allOf": [
                {
                  "$ref": "#/$defs/failureCode"
                },
                {
                  "not": {
                    "enum": [
                      "execution_cancelled",
                      "execution_interrupted"
                    ]
                  }
                }
              ]
            },
            "outcomeIdentityDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "cancelled"
            },
            "failureCode": {
              "const": "execution_cancelled"
            },
            "outcomeIdentityDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "interrupted"
            },
            "failureCode": {
              "const": "execution_interrupted"
            },
            "outcomeIdentityDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "failureCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ]
    }
  }
}
